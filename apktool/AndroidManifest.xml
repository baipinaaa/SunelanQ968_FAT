<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sprd.validationtools.fat"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33"/>

    <application android:label="@string/app_name"
        android:allowBackup="false"
        android:largeHeap="true">

        <activity android:name="com.sprd.validationtools.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name="com.sprd.validationtools.ItemListActivity" android:exported="false"/>
        <activity android:name="com.sprd.validationtools.FatTestActivity" android:exported="false"/>
        <activity android:name="com.sprd.validationtools.TestInfoActivity" android:exported="false"/>
        <activity android:name="com.sprd.validationtools.MaterialInfoActivity" android:exported="false"/>
        <activity android:name="com.sprd.validationtools.ExportActivity" android:exported="false"/>

    </application>

</manifest>
