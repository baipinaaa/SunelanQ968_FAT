<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/sensor_show_msg" />
    <TextView android:id="@+id/txt_msg_gsensor" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    <RelativeLayout android:padding="100dip" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_weight="1">
        <TextView android:id="@+id/txt_sensor_arrow_up" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" />
        <TextView android:id="@+id/txt_sensor_arrow_down" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
        <TextView android:id="@+id/txt_sensor_arrow_left" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:layout_centerVertical="true" />
        <TextView android:id="@+id/txt_sensor_arrow_right" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
    </RelativeLayout>
</LinearLayout>
