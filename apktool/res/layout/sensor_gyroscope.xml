<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/gyroscope_title" />
    <TextView android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/gyroscope_warn" />
    <TextView android:id="@+id/txt_msg_gyroscope" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="vertical" android:padding="100dip" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TextView android:id="@+id/txt_sensor_x" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/txt_sensor_y" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/txt_sensor_z" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
