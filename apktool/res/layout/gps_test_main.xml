<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginBottom="@dimen/pass_fail_button_size"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_weight="1">
        <TextView android:textSize="17dip" android:id="@+id/txt_gps_test_pass" android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textSize="17dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gps_satellite_msg" />
            <TextView android:textSize="17dip" android:id="@+id/txt_gps_satellite_count" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:textSize="17dip" android:id="@+id/txt_gps_not_enabled" android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textSize="17dip" android:id="@+id/txt_gps_time_count" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:textSize="17dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gps_time_msg" />
        </LinearLayout>
        <ScrollView android:layout_width="fill_parent" android:layout_height="fill_parent">
            <TextView android:textSize="17dip" android:id="@+id/txt_gps_satellite_info" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
