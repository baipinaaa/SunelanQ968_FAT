<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:id="@+id/text" style="@style/Text_Title" />
    <TextView android:id="@+id/textView" android:text="@string/key_light_test_title" style="@style/Text_Title" />
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/layout1" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/text1" style="@style/Text_Title" />
        <TextView android:id="@+id/text2" style="@style/Text_Title" />
        <Button android:id="@+id/turnon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/key_light_turn_on" />
        <Button android:id="@+id/turnoff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/key_light_turn_off" />
    </LinearLayout>
</LinearLayout>
