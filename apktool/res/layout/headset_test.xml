<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textSize="@dimen/headset_text_size" android:id="@+id/tx_notice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/headset_notice" />
    <TextView android:textSize="@dimen/headset_text_size" android:textColor="#ff0000" android:id="@+id/tx_insert_headset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/please_plugin" android:layout_below="@+id/tx_notice" />
    <TextView android:textSize="@dimen/headset_text_size" android:textColor="#ff0000" android:id="@+id/tx_press_earkey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/please_press_answer_key" android:layout_below="@+id/tx_insert_headset" />
    <TextView android:textSize="@dimen/headset_text_size" android:textColor="#ff0000" android:id="@+id/tx_start_phoneloop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/please_test_loopback" android:layout_below="@+id/tx_press_earkey" />
    <Button android:enabled="false" android:textSize="@dimen/headset_text_size" android:id="@+id/btn_earkey" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/pass_fail_button_size" android:text="@string/headset_answer_key" android:layout_alignParentBottom="true" />
</RelativeLayout>
