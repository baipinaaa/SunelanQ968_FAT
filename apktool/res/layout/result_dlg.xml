<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:minWidth="300dip"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:textSize="28dp" android:id="@+id/title" android:paddingLeft="8dip" android:paddingRight="8dip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/content" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:textSize="22dp" android:id="@+id/message" android:padding="5dip" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:background="@drawable/bottom_bar" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <Button android:textSize="28dp" android:id="@+id/negativeButton" android:background="@drawable/fail_bg" android:layout_width="0dip" android:layout_height="wrap_content" android:layout_marginTop="3dip" android:singleLine="true" android:layout_weight="1" />
        <Button android:textSize="28dp" android:id="@+id/positiveButton" android:background="@drawable/pass_bg" android:layout_width="0dip" android:layout_height="wrap_content" android:layout_marginTop="3dip" android:singleLine="true" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
