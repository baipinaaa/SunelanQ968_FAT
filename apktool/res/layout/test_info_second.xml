<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:paddingLeft="10dip" android:paddingTop="10dip" android:paddingBottom="10dip" android:layout_width="0dip" android:layout_height="fill_parent" android:layout_weight="1">
            <TextView android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/test_info_title" />
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/sw_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/device_version" />
                <TextView android:textSize="12sp" android:id="@+id/sw_version_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="20sp" android:id="@+id/hw_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/hardware_version" />
                <TextView android:textSize="12sp" android:id="@+id/hw_version_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="20sp" android:id="@+id/data_code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/device_data_code" />
                <TextView android:textSize="12sp" android:id="@+id/data_code_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="20sp" android:id="@+id/testinfo_sn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/device_sn" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_sn_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="20sp" android:id="@+id/testinfo_cu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/device_cu" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_cu_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/testinfo_imei" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/test_info_imei" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_imei_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/testinfo_meid" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/test_info_meid" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_meid_dec" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/testinfo_blt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/test_info_blt" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_blt_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/testinfo_wifi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/wifi_addr" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_wifi_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/tp_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/touchscreen_version" />
                <TextView android:textSize="12sp" android:id="@+id/tp_version_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="20sp" android:id="@+id/audio_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/audio_version" />
                <TextView android:textSize="12sp" android:id="@+id/audio_version_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/testinfo_phase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/test_info_phase_check" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_phase_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/testinfo_test" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/sim_test_result" />
                <TextView android:textSize="12sp" android:id="@+id/test_info_test_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/uid_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:text="@string/uid" />
                <TextView android:textSize="12sp" android:id="@+id/uid" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dip" android:layout_height="fill_parent" android:layout_weight="1">
            <ImageView android:id="@+id/testinfo_qrcode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/test_info" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
