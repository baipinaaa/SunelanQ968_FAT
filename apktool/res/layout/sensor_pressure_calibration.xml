<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:textColor="#ffff0000" android:id="@+id/sensor_pressure_tips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" android:layout_marginBottom="10dip" android:text="@string/pressure_sensor_calibration_tips" />
        <EditText android:textColor="#ffff0000" android:id="@+id/current_pressure" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pressure_sensor_value_unit_tips" android:inputType="number|numberDecimal" />
    </LinearLayout>
    <Button android:id="@+id/start_test_button" android:layout_width="140dip" android:layout_height="wrap_content" android:layout_marginTop="5dip" android:text="@string/start_pressure_calibration" />
    <TextView android:textColor="#ffff0000" android:id="@+id/result_sensor_pressure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="30dip" android:layout_marginTop="120dip" android:layout_marginRight="30dip" />
</LinearLayout>
