<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_above="@+id/btn_retest">
        <TextView android:textSize="20dip" android:id="@+id/bg_test_result" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </ScrollView>
    <Button android:textSize="28dp" android:id="@+id/btn_retest" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/start_retest" android:layout_alignParentBottom="true" />
</RelativeLayout>
