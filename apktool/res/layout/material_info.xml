<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:id="@+id/parent_list" android:paddingLeft="10dip" android:paddingTop="10dip" android:paddingBottom="10dip" android:layout_width="0dip" android:layout_height="fill_parent" android:layout_weight="1">
            <TextView android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/material_info_title" />
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/camera_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" />
                <TextView android:textSize="16sp" android:id="@+id/camera_info_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/emmc_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" />
                <TextView android:textSize="16sp" android:id="@+id/emmc_info_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/display_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" />
                <TextView android:textSize="16sp" android:id="@+id/display_info_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:id="@+id/tp_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dip" />
                <TextView android:textSize="16sp" android:id="@+id/tp_info_dec" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
