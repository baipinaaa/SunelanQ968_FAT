<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageButton android:id="@+id/volume_up_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:src="@drawable/voice_up" />
    <ImageButton android:id="@+id/volume_down_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:src="@drawable/voice_down" />
    <ImageButton android:gravity="center" android:id="@+id/menu_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:src="@drawable/menu" />
    <ImageButton android:gravity="center" android:id="@+id/home_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:src="@drawable/home" />
    <ImageButton android:gravity="center" android:id="@+id/back_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:src="@drawable/back" />
    <ImageButton android:id="@+id/camera_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:src="@drawable/camera" />
    <Button android:id="@+id/ai_button" android:clickable="false" android:layout_width="180dip" android:layout_height="wrap_content" android:text="@string/ai_key_test" />
</LinearLayout>
