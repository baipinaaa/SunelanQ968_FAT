<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginBottom="@dimen/pass_fail_button_size"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textSize="17dip" android:id="@+id/wifi_addr" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/wifi_addr" />
    <TextView android:textSize="17dip" android:id="@+id/wifi_addr_content" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    <TextView android:textSize="17dip" android:id="@+id/wifi_state" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/wifi_state" />
    <TextView android:textSize="17dip" android:id="@+id/wifi_state_content" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    <TextView android:textSize="17dip" android:id="@+id/wifi_device" android:paddingTop="20px" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/wifi_device" />
    <ScrollView android:layout_width="fill_parent" android:layout_height="fill_parent">
        <TextView android:textSize="17dip" android:id="@+id/tv_wifi_device_list" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
